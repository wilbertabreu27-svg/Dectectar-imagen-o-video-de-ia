<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLoginApp.MainPage"
             BackgroundColor="#228B22">

    <Grid VerticalOptions="Center" HorizontalOptions="Center">
        <Frame BackgroundColor="#FFFF99" CornerRadius="12" HasShadow="True" Padding="20" WidthRequest="360" HeightRequest="300" x:Name="card">
            <StackLayout Spacing="12">
                <Label Text="Iniciar sesión" FontSize="20" HorizontalOptions="Center" />

                <StackLayout>
                    <Label Text="Usuario" />
                    <Entry x:Name="usernameEntry" Placeholder="usuario" />
                    <BoxView x:Name="underlineUser" HeightRequest="3" BackgroundColor="Gold" ScaleX="0" HorizontalOptions="Start" />
                </StackLayout>

                <StackLayout>
                    <Label Text="Contraseña" />
                    <Entry x:Name="passwordEntry" Placeholder="contraseña" IsPassword="True" />
                    <BoxView x:Name="underlinePassword" HeightRequest="3" BackgroundColor="Gold" ScaleX="0" HorizontalOptions="Start" />
                </StackLayout>

                <Button x:Name="btnLogin" Text="Entrar" HorizontalOptions="Center" WidthRequest="140" />

            </StackLayout>
        </Frame>
    </Grid>

</ContentPage>

    
    